{
  "name": "@svedata/data",
  "version": "0.2.0",
  "description": "TypeScript SDK for 14 Swedish public data APIs: weather, statistics, energy, education, tourism and more.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@svedata/types": "workspace:^"
  },
  "devDependencies": {
    "msw": "^2.6.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "keywords": [
    "typescript",
    "sdk",
    "sweden",
    "open-data",
    "government-api",
    "smhi",
    "scb",
    "riksbanken",
    "svk",
    "skolverket",
    "visitsweden",
    "hav",
    "svedata"
  ]
}
