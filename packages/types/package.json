{
  "name": "@svedata/types",
  "version": "0.2.0",
  "description": "Shared TypeScript types for Svedata — 14 Swedish public data APIs.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Svedata/svedata.git",
    "directory": "packages/types"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "echo 'no tests'"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  },
  "keywords": [
    "typescript",
    "types",
    "sweden",
    "svedata",
    "open-data"
  ]
}
